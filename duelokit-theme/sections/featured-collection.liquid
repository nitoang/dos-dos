{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections.all
  endif
-%}

<section class="section">
  <div class="page-width">
    <div class="section__head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.show_view_all -%}
        <a class="text-link" href="{{ collection.url }}">{{ 'collections.view_all' | t }}</a>
      {%- endif -%}
    </div>

    <ul class="grid grid--{{ section.settings.columns }}" role="list">
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        <li>{% render 'product-card', product: product %}</li>
      {%- else -%}
        {%- for i in (1..4) -%}
          <li>{% render 'product-card', product: nil %}</li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The kits." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show “View all” link", "default": true }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
