<section class="section newsletter">
  <div class="page-width newsletter__inner">
    <div class="accent-bar" aria-hidden="true"></div>
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="newsletter__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email_label' | t }}</label>
      <div class="pill-form">
        <input
          id="NewsletterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          placeholder="{{ 'newsletter.email_placeholder' | t }}"
          required
        >
        <button type="submit" class="button">{{ section.settings.button_label }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="form-status" role="status">{{ 'newsletter.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Email signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A note when something new is ready." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Leave your email and we'll let you know." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" }
  ],
  "presets": [
    { "name": "Email signup" }
  ]
}
{% endschema %}
