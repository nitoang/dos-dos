{%- paginate blog.articles by 9 -%}
  <section class="section">
    <div class="page-width">
      <header class="page-head">
        <h1>{{ blog.title }}</h1>
      </header>

      {%- if blog.articles.size == 0 -%}
        <p class="empty">{{ 'blog.empty' | t }}</p>
      {%- else -%}
        <ul class="grid grid--3" role="list">
          {%- for article in blog.articles -%}
            <li>
              <article class="card">
                {%- if article.image != blank -%}
                  <a class="card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                    {{ article.image | image_url: width: 640 | image_tag: widths: '320, 480, 640', sizes: '(min-width: 1000px) 33vw, (min-width: 667px) 50vw, 100vw', loading: 'lazy', alt: article.image.alt }}
                  </a>
                {%- endif -%}
                <div class="card__body">
                  <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
                  <h2 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
                  {%- assign summary = article.excerpt | default: article.content -%}
                  <p class="card__text">{{ summary | strip_html | truncate: 140 }}</p>
                </div>
              </article>
            </li>
          {%- endfor -%}
        </ul>

        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog page"
}
{% endschema %}
