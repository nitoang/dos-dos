<section class="section section--flush-top">
  <div class="page-width page-width--narrow">
    {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status" role="status">{{ 'contact.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="field">
        <label class="eyebrow" for="ContactName">{{ 'contact.name' | t }}</label>
        <input id="ContactName" name="contact[name]" type="text" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
      </div>

      <div class="field">
        <label class="eyebrow" for="ContactEmail">{{ 'contact.email' | t }}</label>
        <input id="ContactEmail" name="contact[email]" type="email" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
      </div>

      <div class="field">
        <label class="eyebrow" for="ContactMessage">{{ 'contact.message' | t }}</label>
        <textarea id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      </div>

      <button type="submit" class="button">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form"
}
{% endschema %}
