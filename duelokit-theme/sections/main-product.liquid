{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
-%}

<section class="section" data-product>
  <div class="page-width product">
    <div class="product__media">
      {%- for media in product.media -%}
        {%- liquid
          assign loading = 'lazy'
          if forloop.first
            assign loading = 'eager'
          endif
        -%}
        <div class="product__media-item{% if forloop.first %} product__media-item--first{% endif %}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {{ media | image_url: width: 1100 | image_tag: widths: '550, 825, 1100', sizes: '(min-width: 820px) 55vw, 100vw', loading: loading, alt: media.alt }}
            {%- when 'video' -%}
              {{ media | video_tag: controls: true, image_size: '1100x' }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag }}
            {%- when 'model' -%}
              {{ media | model_viewer_tag }}
          {%- endcase -%}
        </div>
      {%- else -%}
        <div class="product__media-item product__media-item--first">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endfor -%}
    </div>

    <div class="product__info">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="product__title">{{ product.title }}</h1>

      {% render 'price', product: product, live: true %}

      {%- form 'product', product, id: form_id, class: 'product-form' -%}
        <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="option">
              <legend class="eyebrow">{{ option.name }}</legend>
              <div class="option__values">
                {%- for value in option.values -%}
                  <input
                    type="radio"
                    id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                    name="{{ option.name | escape }}"
                    value="{{ value | escape }}"
                    {% if option.selected_value == value %}checked{% endif %}
                  >
                  <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">{{ value }}</label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        <button
          type="submit"
          name="add"
          class="button button--full"
          data-add-button
          data-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
          data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
          data-unavailable-label="{{ 'products.product.unavailable' | t | escape }}"
          {% unless variant.available %}disabled{% endunless %}
        >
          {%- if variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="product__description rte">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-variants>
    [
      {%- for v in product.variants -%}
        {
          "id": {{ v.id }},
          "options": {{ v.options | json }},
          "available": {{ v.available | json }},
          "price": {{ v.price | money | json }},
          "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}""{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Instant download" }
  ]
}
{% endschema %}
