<section class="section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul class="panels" role="list">
      {%- for block in section.blocks -%}
        <li class="panel panel--{{ block.settings.tint }}" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2 class="panel__title">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="panel__text rte">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.link != blank and block.settings.link_label != blank -%}
            <a class="text-link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Panels",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        {
          "type": "select",
          "id": "tint",
          "label": "Color",
          "options": [
            { "value": "sage", "label": "Deep sage" },
            { "value": "blush", "label": "Blush" },
            { "value": "olive", "label": "Olive mist" }
          ],
          "default": "sage"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Short and plain." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Short sentences. Plain words. Nothing asks more of you than you have.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Panels",
      "blocks": [
        { "type": "panel", "settings": { "tint": "sage" } },
        { "type": "panel", "settings": { "tint": "blush" } },
        { "type": "panel", "settings": { "tint": "olive" } }
      ]
    }
  ]
}
{% endschema %}
