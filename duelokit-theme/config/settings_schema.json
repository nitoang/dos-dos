  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Page width", "default": 1200 }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Square image, at least 32 x 32 px." }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      { "type": "checkbox", "id": "cart_note", "label": "Allow an order note", "default": false }
    ]
