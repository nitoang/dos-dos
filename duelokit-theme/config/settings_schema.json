  {
    "name": "Coming soon",
    "settings": [
      { "type": "header", "content": "Public coming-soon page" },
      {
        "type": "checkbox",
        "id": "coming_soon_mode",
        "label": "Show the coming-soon page to customers",
        "info": "While this is on, customers see only the coming-soon page and can leave their email. The theme editor still shows the full site. Turn it off when you're ready to go live. To see the page, use Preview rather than the editor.",
        "default": true
      },
      { "type": "text", "id": "coming_soon_wordmark", "label": "Wordmark", "default": "duelokit." },
      { "type": "text", "id": "coming_soon_eyebrow", "label": "Eyebrow", "default": "Coming soon" },
      { "type": "text", "id": "coming_soon_heading", "label": "Heading", "default": "We're still building." },
      { "type": "textarea", "id": "coming_soon_text", "label": "Text", "default": "Leave your email and we'll let you know when it's ready." },
      { "type": "text", "id": "coming_soon_button", "label": "Button label", "default": "Notify me" },
      { "type": "text", "id": "coming_soon_success", "label": "Thank-you message", "default": "Thank you. We'll let you know when it's ready." }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "header", "content": "Ink" },
      { "type": "color", "id": "color_ink", "label": "Ink", "info": "Headings, buttons, borders.", "default": "#1F4A3D" },
      { "type": "color", "id": "color_ink_soft", "label": "Soft ink", "info": "Body copy, eyebrows, helper text.", "default": "#3F5A4F" },
      { "type": "header", "content": "Grounds" },
      { "type": "color", "id": "color_ground", "label": "Page ground", "default": "#E9F0E7" },
      { "type": "color", "id": "color_card", "label": "Cream", "info": "Cards, inputs, footer.", "default": "#FAF7F0" },
      { "type": "header", "content": "Panels" },
      { "type": "color", "id": "color_sage_deep", "label": "Deep sage", "info": "Arch panel, announcement bar, image backing.", "default": "#D5E4D8" },
      { "type": "color", "id": "color_olive", "label": "Olive mist", "default": "#E6EADB" },
      { "type": "color", "id": "color_blush", "label": "Blush", "default": "#F3E8DF" },
      { "type": "header", "content": "Lines" },
      { "type": "color", "id": "color_rule", "label": "Rule", "info": "Dividers and input borders.", "default": "#9DB0A3" },
      { "type": "color", "id": "color_outline", "label": "Outline", "info": "Option chips and outlined boxes.", "default": "#7C9A8A" },
      { "type": "header", "content": "Accent" },
      { "type": "color", "id": "color_accent", "label": "Marigold", "info": "Decoration only. Never used for text.", "default": "#E3A02E" }
    ]
