{%- comment -%}
  The coming-soon page, built from the duelokit coming-soon design: wordmark, marigold bar,
  eyebrow, headline, lede and a pill email form on a sage ground.
  Text comes from Theme settings > Coming soon.
  Accepts:
  - banner: {Boolean} render as a section at the top of a page (no full-height, h2 instead of h1, no copyright)
  - owner_access: {Boolean} show the storefront-password entry (only used on the password page)
{%- endcomment -%}

<section class="coming-soon{% if banner %} coming-soon--banner{% endif %}">
  <p class="wordmark wordmark--landing">{{ settings.coming_soon_wordmark | default: 'duelokit.' }}</p>
  <div class="accent-bar" aria-hidden="true"></div>

  {%- assign cs_eyebrow = settings.coming_soon_eyebrow | default: 'Coming soon' -%}
  {%- if cs_eyebrow != blank -%}
    <p class="eyebrow">{{ cs_eyebrow }}</p>
  {%- endif -%}

  {%- if banner -%}
    <h2 class="coming-soon__title">{{ settings.coming_soon_heading | default: "We're still building." }}</h2>
  {%- else -%}
    <h1 class="coming-soon__title">{{ settings.coming_soon_heading | default: "We're still building." }}</h1>
  {%- endif -%}

  {%- assign cs_text = settings.coming_soon_text | default: "Leave your email and we'll let you know when it's ready." -%}
  {%- if cs_text != blank -%}
    <p class="coming-soon__lede">{{ cs_text }}</p>
  {%- endif -%}

  {%- form 'customer', id: 'ComingSoonForm', class: 'coming-soon__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <label class="visually-hidden" for="ComingSoonEmail">{{ 'newsletter.email_label' | t }}</label>
    <div class="pill-form">
      <input
        id="ComingSoonEmail"
        type="email"
        name="contact[email]"
        value="{{ form.email }}"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        placeholder="{{ 'newsletter.email_placeholder' | t }}"
        required
        {% if form.errors %}aria-invalid="true"{% endif %}
      >
      <button type="submit" class="button">{{ settings.coming_soon_button | default: 'Notify me' }}</button>
    </div>
    {%- if form.posted_successfully? -%}
      <p class="form-status" role="status">{{ settings.coming_soon_success | default: "Thank you. We'll let you know when it's ready." }}</p>
    {%- endif -%}
    {%- if form.errors -%}
      <p class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</p>
    {%- endif -%}
  {%- endform -%}

  {%- if owner_access -%}
    <details class="owner-access">
      <summary>{{ 'password.owner_summary' | t }}</summary>
      {%- form 'storefront_password' -%}
        <label class="visually-hidden" for="StorefrontPassword">{{ 'password.password_label' | t }}</label>
        <div class="pill-form">
          <input
            id="StorefrontPassword"
            type="password"
            name="password"
            autocomplete="current-password"
            placeholder="{{ 'password.password_label' | t }}"
            required
          >
          <button type="submit" class="button button--secondary">{{ 'password.enter' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </details>
  {%- endif -%}

  <p class="fine-print">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | downcase }}</p>
</section>
